{
  "name": "vless-server",
  "version": "1.0.0",
  "description": "A tunnel for the edgetunnel project to allow deployed applications to cloudflare pages and workers to be accessed via a custom domain.",
  "main": "_worker.js",
  "scripts": {
    "deploy": "wrangler deploy",
    "predeploy": "node scripts/socks-creds.mjs",
    "socks:rotate": "node scripts/socks-creds.mjs --rotate",
    "build": "wrangler deploy --dry-run",
    "dev": "wrangler dev --remote",
    "test": "node --test \"test/*.test.mjs\""
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "wrangler": "^4.129.0"
  }
}
